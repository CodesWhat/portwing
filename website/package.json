{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "npm run build:docs-content",
    "build": "next build",
    "postbuild": "node scripts/security-headers.mjs",
    "build:docs-content": "(cd ../docs && npm run build) && rm -rf public/docs && mkdir -p public/docs && cp -R ../docs/out/. public/docs/",
    "lint": "tsc --noEmit",
    "start": "next start --port 3001",
    "test:headers": "node --test scripts/security-headers.test.mjs"
  },
  "dependencies": {
    "@codeswhat/public-analytics": "*",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    },
    "postcss": "^8.5.28"
  }
}
