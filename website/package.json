{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "npm run build:docs-content",
    "build": "next build",
    "postbuild": "node scripts/security-headers.mjs",
    "build:docs-content": "(cd ../docs && npm run build) && rm -rf public/docs && mkdir -p public/docs && cp -R ../docs/out/. public/docs/",
    "lint": "tsc --noEmit",
    "start": "next start --port 3001",
    "test:headers": "node --test scripts/security-headers.test.mjs"
  },
  "dependencies": {
    "@codeswhat/public-analytics": "*",
    "next": "16.4.3",
    "postcss": "^8.5.31",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "postcss": "$postcss"
  }
}
