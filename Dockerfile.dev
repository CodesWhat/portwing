FROM golang:1.27.2-alpine@sha256:85dc1069ac644ea3c527b177303a406eb3358192816cd7f9e5848eb658851673
# Mirror the release images: dedicated portwing user (UID 65532). Reaching
# the host Docker socket requires --group-add with the socket's GID.
RUN apk add --no-cache git docker-cli docker-compose \
    && addgroup -g 65532 portwing \
    && adduser -D -H -u 65532 -G portwing -h /home/portwing -s /sbin/nologin portwing \
    && install -d -o 65532 -g 65532 /home/portwing /data/stacks
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /portwing ./cmd/portwing

ENV HOME=/home/portwing \
    DOCKER_CONFIG=/tmp/.docker
USER 65532:65532

VOLUME /data/stacks
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/bin/sh", "-c", "if [ -n \"$TLS_CERT\" ]; then wget -q --no-check-certificate --spider \"https://localhost:${PORT:-3000}/health\"; else wget -q --spider \"http://localhost:${PORT:-3000}/health\"; fi"]

ENTRYPOINT ["/portwing"]