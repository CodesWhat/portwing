{
  "name": "portwing-web",
  "private": true,
  "workspaces": [
    "website",
    "docs",
    "analytics"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test:web": "node --test analytics/src/contract.test.ts scripts/*.test.mjs && npm --workspace website run test:headers",
    "knip": "knip",
    "docs:archive": "node scripts/docs-archive-cut.mjs",
    "docs:export-contract": "node scripts/docs-export-contract.mjs",
    "budget:web": "node scripts/page-weight-budget.mjs",
    "lighthouse:marketing": "node scripts/lighthouse-budget.mjs lighthouse/marketing.cjs",
    "lighthouse:docs": "node scripts/lighthouse-budget.mjs lighthouse/docs.cjs",
    "lighthouse": "npm run lighthouse:marketing && npm run lighthouse:docs",
    "check:web": "node scripts/node-version-contract.mjs && npm run test:web && npm run lint && npm run knip && npm run build && npm run docs:export-contract && npm run budget:web && npm run lighthouse"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "chrome-launcher": "1.2.2",
    "knip": "6.39.0",
    "lighthouse": "13.5.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "turbo": "2.11.6",
    "unified": "11.0.5"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "next": {
      "sharp": "^0.35.4"
    }
  },
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
